    "History is recorded after each scan.\nCome back in a few scans to see your progress." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Verlauf wird nach jedem Scan aufgezeichnet.\nKommen Sie nach einigen Scans wieder, um Ihren Fortschritt zu sehen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’historique est enregistré après chaque analyse.\nRevenez dans quelques analyses pour voir votre progression."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "履歴はスキャンのたびに記録されます。\n何回かスキャンを行ったあと、進捗を確認してみてください。"
          }
        }
      }
    },
    "How to fix" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
