            "state" : "translated",
            "value" : "Aktivieren Sie die anonyme Community-Freigabe, um Empfehlungen freizuschalten. Personenbezogene Daten werden niemals gesendet."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activez le partage communautaire anonyme pour débloquer les recommandations. Aucune information personnelle n’est jamais envoyée."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "推奨を有効化するために、匿名のコミュニティ共有を有効にしてください。個人情報が送信されることはありません。"
          }
        }
      }
    },
    "Enable anonymous community sharing to unlock recommendations. Paths, file contents, and personal information are never sent." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktivieren Sie die anonyme Community-Freigabe, um Empfehlungen freizuschalten. Pfade, Dateiinhalte und personenbezogene Daten werden niemals gesendet."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activez le partage communautaire anonyme pour accéder aux recommandations. Les chemins, contenus de fichiers et informations personnelles ne sont jamais envoyés."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "推奨情報を利用するには, 匿名のコミュニティ共有を有効にしてください. パス, ファイルの内容, 個人情報は送信されません."
          }
        }
