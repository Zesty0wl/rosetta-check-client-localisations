    "Checked %lld command-line tools. %lld are 32-bit and unsupported by current macOS." : {
      "comment" : "The message for the background alert when the tool scan is complete. The first argument is the total number of tools that were scanned. The second argument is the number of tools that are 32-bit and unsupported by current macOS.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "en" : {
