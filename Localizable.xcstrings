          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "そのフォルダは Rosetta Check がすでにスキャンしているフォルダと重複しています."
          }
        }
      }
    },
    "This command is installed and updated as part of %@, not as a standalone tool." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
