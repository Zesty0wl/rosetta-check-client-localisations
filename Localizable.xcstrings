    "All bundled components run natively on Apple Silicon." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle eingebetteten Komponenten laufen nativ auf Apple Silicon."
          }
        },
