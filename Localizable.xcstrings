    "Walks Universal/Apple Silicon apps for embedded plug-ins, XPC services, frameworks, and helpers. Slightly slower at scan time." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Durchsucht Universal-/Apple-Silicon-Apps nach eingebetteten Plug-ins, XPC-Diensten, Frameworks und Helfern. Beim Scannen etwas langsamer."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parcourt les apps Universal/Apple Silicon à la recherche de plug-ins intégrés, de services XPC, de frameworks et d’assistants. Légèrement plus lent à l’analyse."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Universal / Apple Silicon の App を巡回し、組み込みのプラグイン、XPC サービス、フレームワーク、ヘルパーを検査します。スキャン時間はやや長くなります。"
          }
        }
      }
    },
    "Warnings Off" : {
      "localizations" : {
