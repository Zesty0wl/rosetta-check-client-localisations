    "Add folders that are not covered by Built-in Locations. Custom folders are saved with read-only access and can be removed at any time." : {
      "comment" : "A description of the custom folders section.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fügen Sie Ordner hinzu, die nicht zu den integrierten Orten gehören. Eigene Ordner werden mit Lesezugriff gespeichert und lassen sich jederzeit entfernen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoutez les dossiers non couverts par les emplacements intégrés. Les dossiers personnalisés sont enregistrés en lecture seule et peuvent être supprimés à tout moment."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "組み込みの場所に含まれないフォルダを追加します。カスタムフォルダは読み取り専用で保存され、いつでも削除できます。"
          }
        }
      }
    },
