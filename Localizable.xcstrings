    "Standard plug-in locations and embedded app components are scanned automatically. Use Custom Folders above for anything stored elsewhere." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Standard-Speicherorte für Plug-ins und eingebettete App-Komponenten werden automatisch gescannt. Verwenden Sie oben „Benutzerdefinierte Ordner“ für alles, was anderswo gespeichert ist."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les emplacements standard des plug-ins et les composants intégrés aux apps sont analysés automatiquement. Utilisez la section Dossiers personnalisés ci-dessus pour tout élément stocké ailleurs."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "標準のプラグイン保存場所と App 内のコンポーネントは自動的にスキャンされます. その他の場所に保存されている項目をスキャンするには, 上のカスタムフォルダ機能を使用してください."
          }
        }
      }
    },
    "Switch off launch-at-login, stop monitoring, and reveal the app in Finder so you can drag it to the Trash." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deaktivieren Sie „Bei der Anmeldung starten“, beenden Sie die Überwachung und zeigen Sie die App im Finder an, damit Sie sie in den Papierkorb ziehen können."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Désactivez le lancement à l’ouverture de session, arrêtez la surveillance et affichez l’app dans le Finder afin de pouvoir la faire glisser vers la Corbeille."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ログイン時の起動をオフにして監視を停止し, App を Finder に表示してゴミ箱へドラッグできるようにします."
          }
        }
      }
    },
    "That folder overlaps a folder Rosetta Check already scans." : {
      "comment" : "Alert message when a user tries to add a folder that overlaps a folder already being scanned.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Ordner überschneidet sich mit einem Ordner, den Rosetta Check bereits scannt."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
