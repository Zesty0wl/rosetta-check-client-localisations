            "value" : "同梱されたコンポーネントはすべて Apple Silicon でネイティブに動作しています。"
          }
        }
      }
    },
    "All clear — no apps need Rosetta" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alles in Ordnung – keine App benötigt Rosetta"
          }
        },
