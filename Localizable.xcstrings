        }
      }
    },
    "When enabled, anonymous Intel app and component metadata plus package-level Tool compatibility is shared with the RosettaCheck community. Tool paths and file contents are never sent." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn aktiviert, werden anonyme Metadaten zu Intel-Apps und -Komponenten sowie die Tool-Kompatibilität auf Paketebene mit der RosettaCheck-Community geteilt. Tool-Pfade und Dateiinhalte werden niemals gesendet."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lorsque cette option est activée, les métadonnées anonymes des apps Intel et des composants Intel, ainsi que la compatibilité des outils par paquet, sont partagées avec la communauté RosettaCheck. Les chemins des outils et le contenu des fichiers ne sont jamais envoyés."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有効にすると, 匿名化された Intel App とコンポーネントのメタデータ, およびパッケージ単位のツール互換性情報が RosettaCheck コミュニティと共有されます. ツールのパスとファイルの内容が送信されることはありません."
          }
        }
      }
    },
    "Your Apple Silicon readiness score is %lld out of 100. %@" : {
      "localizations" : {
